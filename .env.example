# App
PORT=3000
HOSTNAME=0.0.0.0
DOWNLOAD_DIR=/tmp/pluck

# Delete finished files from disk and S3 after this many hours (default 12)
RETENTION_HOURS=12

# Optional: require this value in the x-pluck-password header (or UI field)
# APP_PASSWORD=

# yt-dlp / ffmpeg (defaults work in Docker)
# YT_DLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg

# S3-compatible bucket (recommended on Railway — disk is ephemeral)
# S3_ENDPOINT=https://your-endpoint
# S3_REGION=auto
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=pluck
# Optional public CDN/base URL instead of presigned links
# S3_PUBLIC_URL=
